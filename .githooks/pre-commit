#!/bin/bash
# pre-commit — the authoritative claim gate.
#
# WHY HERE. This started as a PreToolUse hook in the agent harness. That layer runs
# BEFORE the command, so it can only inspect state the command has not created yet: a
# single `echo > index.html && git add index.html && git commit` sailed through, because
# at hook time the tree was clean. Measured, not theorised. A pre-commit hook runs inside
# git with the final staged index, so the timing gap does not exist, and it also covers
# commits made from a terminal, an editor, or a script rather than only from a session.
#
# WHAT IT DOES. Deterministic, and it never decides whether a claim is true. It decides
# which staged files are claim-bearing per .claim-paths, and whether each is covered by a
# receipt in .claim-review-ack. EVIDENCE pointers are RESOLVED (a local path must exist,
# an https pointer must return 2xx), so a receipt cannot be satisfied by writing prose.
# OVERRIDE is permitted, requires a reason, and is appended to .claim-review-audit.log.
#
# FAILS CLOSED on a malformed receipt line or an unreadable .claim-paths.
#
# RECEIPT GRAMMAR. One line per claim-bearing file in .claim-review-ack:
#
#     <path> :: EVIDENCE <existing-path-or-200-url> :: blob <full-40-hex-sha1>
#     <path> :: OVERRIDE <reason>                   :: blob <full-40-hex-sha1>
#
# <sha> is the STAGED blob, `git rev-parse :<path>`, and must be the FULL 40-character
# object id. A prefix is not accepted: the line is selected by literal substring match on
# ":: blob <sha>", so a short id would match any blob sharing that head. Mutation testing
# found exactly this: truncating the comparison to four hex characters passed the whole
# regression suite until a prefix case was added.
#
# WHY A BLOB AND NOT A PATH. Selection used `grep -F "<path> ::" | head -1`, so the first
# line naming the path won regardless of what it said or when it was written. A receipt
# recorded for an earlier version of a file kept satisfying every later version: the gate
# reported success along a path where it never examined the staged content. Binding to the
# blob makes a stale review a refusal instead of a silent pass, and removes the line-order
# dependency the old head -1 created.
#
# MIGRATION. Path-only receipts written under the previous grammar no longer satisfy
# anything, by design: they are the hole. The next commit touching a claim-bearing file
# will be refused with "no receipt carries the staged blob"; re-issue the line with the
# blob appended. .claim-review-ack is gitignored, so this is a local-only migration.
#
# RESIDUAL, and it is not small: `git commit --no-verify` skips every client-side hook.
# No local hook can be a complete policy boundary. If enforcement must survive a
# deliberate bypass, the publish path has to check receipts independently before deploy.

set -u
REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$REPO/.claim-paths" ] || exit 0

if ! PATTERNS=$(grep -v '^[[:space:]]*#' "$REPO/.claim-paths" 2>/dev/null | grep -v '^[[:space:]]*$'); then
    echo "claim gate: .claim-paths is unreadable. Refusing rather than guessing." >&2
    exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
[ -z "$STAGED" ] && exit 0

# suite/sources.json owns its own gate: .githooks/sources_receipt.py re-fetches the new pinned
# url and hashes it, which is strictly stronger than the EVIDENCE pointer the loop below can
# check. It is therefore NOT listed in .claim-paths, which means MATCHED can be empty on a commit
# that changes nothing else. This must run BEFORE the `[ -z "$MATCHED" ] && exit 0` early exit, or
# a lone manifest change sails through unchecked: exempting the file from one gate silently
# exempted it from both.
if printf '%s' "$STAGED" | grep -qx 'suite/sources.json'; then
    if ! python3 "$REPO/.githooks/sources_receipt.py"; then exit 1; fi
fi

MATCHED=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    while IFS= read -r p; do
        [ -z "$p" ] && continue
        case "$f" in $p) MATCHED="$MATCHED$f"$'\n'; break;; esac
        case "$(basename "$f")" in $p) MATCHED="$MATCHED$f"$'\n'; break;; esac
    done <<< "$PATTERNS"
done <<< "$STAGED"
MATCHED=$(printf '%s' "$MATCHED" | grep -v '^$' | sort -u)
[ -z "$MATCHED" ] && exit 0

ACK="$REPO/.claim-review-ack"
MISSING="" ; UNRESOLVED="" ; OVERRIDES="" ; STALE=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    # A receipt is bound to the blob it reviewed:  <path> :: KIND <ref> :: blob <sha1>
    # Selection is BY BLOB, not by line order. `head -1` on a pathname let a receipt
    # written for an older version of a file satisfy every later version of it: the gate
    # reported success along a path where it never examined the staged content.
    BLOB=$(git rev-parse ":$f" 2>/dev/null)
    if [ -z "$BLOB" ]; then
        UNRESOLVED="$UNRESOLVED  $f -> could not read staged blob"$'\n'; continue
    fi
    LINE=$(grep -F -- "$f ::" "$ACK" 2>/dev/null | grep -F -- ":: blob $BLOB" | head -1)
    if [ -z "$LINE" ]; then
        if grep -qF -- "$f ::" "$ACK" 2>/dev/null; then
            STALE="$STALE  $f -> no receipt carries the staged blob $BLOB"$'\n'
        else
            MISSING="$MISSING  $f"$'\n'
        fi
        continue
    fi
    LINE=${LINE%% :: blob *}
    KIND=$(printf '%s' "$LINE" | sed -E 's/.*:: *([A-Z]+).*/\1/')
    REF=$(printf '%s' "$LINE" | sed -E 's/.*:: *[A-Z]+ *//')
    case "$KIND" in
      OVERRIDE)
        if [ -z "$REF" ]; then
            UNRESOLVED="$UNRESOLVED  $f -> OVERRIDE with no reason"$'\n'
        else
            OVERRIDES="$OVERRIDES  $f -> $REF"$'\n'
        fi ;;
      EVIDENCE)
        if [ -z "$REF" ]; then
            UNRESOLVED="$UNRESOLVED  $f -> EVIDENCE with no pointer"$'\n'
        elif printf '%s' "$REF" | grep -qE '^https://'; then
            code=$(curl -s -o /dev/null -m 20 -w '%{http_code}' "$REF" 2>/dev/null)
            case "$code" in 2*) ;; *) UNRESOLVED="$UNRESOLVED  $f -> $REF (HTTP $code)"$'\n';; esac
        elif [ ! -e "$REF" ] && [ ! -e "$REPO/$REF" ]; then
            UNRESOLVED="$UNRESOLVED  $f -> $REF (no such path)"$'\n'
        fi ;;
      *) UNRESOLVED="$UNRESOLVED  $f -> malformed receipt line"$'\n' ;;
    esac
done <<< "$MATCHED"

if [ -n "$OVERRIDES" ]; then
    printf '%s  commit OVERRIDE\n%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$OVERRIDES" \
        >> "$REPO/.claim-review-audit.log"
fi

if [ -n "$MISSING" ] || [ -n "$UNRESOLVED" ] || [ -n "$STALE" ]; then
    {
      echo "claim gate: commit blocked. Claim-bearing files staged with no resolved receipt."
      [ -n "$MISSING" ]    && { echo; echo "No receipt line in .claim-review-ack for:"; printf '%s' "$MISSING"; }
      [ -n "$UNRESOLVED" ] && { echo; echo "Receipt present but the evidence pointer did not resolve:"; printf '%s' "$UNRESOLVED"; }
      [ -n "$STALE" ]      && { echo; echo "Receipt present but written for a different blob (stale review):"; printf '%s' "$STALE"; echo "  (a receipt with no ':: blob <sha>' is pre-migration grammar and never matches)"; }
      echo
      echo "Add one line per file to .claim-review-ack, bound to the staged blob:"
      echo "  <path> :: EVIDENCE <existing-path-or-200-url> :: blob \$(git rev-parse :<path>)"
      echo "  <path> :: OVERRIDE <reason> :: blob \$(git rev-parse :<path>)"
      echo
      echo "EVIDENCE is resolved by this hook. Verify the claim against the artifact, not a note."
    } >&2
    exit 1
fi
exit 0
